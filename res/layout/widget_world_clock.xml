<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/world_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/battery_bg_color"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/world_clock_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:fontFamily="nothingdot57"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/battery_device_primary_color"
        android:textSize="12sp" />

    <TextClock
        android:id="@+id/world_clock_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:format12Hour="hh:mm a"
        android:format24Hour="HH:mm"
        android:fontFamily="nothingdot57"
        android:includeFontPadding="false"
        android:textColor="@color/battery_device_primary_color"
        android:textSize="40sp" />

</LinearLayout>
