<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/battery_bg_color"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/countdown_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="nothingdot57"
            android:includeFontPadding="false"
            android:textColor="@color/battery_device_primary_color"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/countdown_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:fontFamily="nothingdot57"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingBottom="10dp"
            android:textColor="@color/battery_device_primary_color"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/countdown_event_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="nothingdot57"
        android:maxLines="2"
        android:textColor="@color/battery_device_primary_color"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/countdown_target_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.5"
        android:fontFamily="nothingdot57"
        android:textColor="@color/battery_device_primary_color"
        android:textSize="11sp" />

</LinearLayout>
