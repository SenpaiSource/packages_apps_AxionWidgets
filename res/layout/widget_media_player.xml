<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_media_widget"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!-- Album art (full bleed) -->
    <ImageView
        android:id="@+id/album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Active media content overlay -->
    <FrameLayout
        android:id="@+id/media_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Gradient scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_media_scrim" />

        <!-- Track info + controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:fontFamily="nothingdot57"
                android:textFontWeight="500" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/track_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="#B3FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:fontFamily="nothingdot57"
                    android:textFontWeight="300" />

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_prev" />

                <ImageView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_play" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_next" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/media_progressbar" />
        </LinearLayout>
    </FrameLayout>

    <!-- Idle state (no media) -->
    <FrameLayout
        android:id="@+id/media_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_media_widget"
        android:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:src="@drawable/ic_media_default" />
    </FrameLayout>

</FrameLayout>
