<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|start">

        <TextClock
            android:id="@+id/date"
            style="@style/QuickLookPreviewDateTextStyle"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM" />

        <LinearLayout
            android:id="@+id/secondary_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/secondary_container_margin_top"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/media_icon"
                style="@style/IconStyle"
                android:layout_marginEnd="@dimen/quicklook_secondary_info_margin_horizontal"
                android:tint="@color/quicklook_preview_secondary_color"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/weather_icon"
                style="@style/IconStyle"
                android:layout_marginEnd="@dimen/quicklook_secondary_info_margin_horizontal"
                android:tint="@color/quicklook_preview_secondary_color"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/secondary_icon"
                style="@style/IconStyle"
                android:layout_marginEnd="@dimen/quicklook_secondary_info_margin_horizontal"
                android:tint="@color/quicklook_preview_secondary_color"
                android:visibility="gone" />

            <TextView
                android:id="@+id/primary_text_info"
                style="@style/QuickLookPreviewPrimaryTextInfoStyle"
                android:text="@string/setup_title" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
