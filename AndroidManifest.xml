<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.axion.widgets"
    android:sharedUserId="android.uid.system">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:name=".AxionApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hasCode="true"
        android:persistent="true"
        android:allowBackup="false"
        android:directBootAware="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <receiver
            android:name="com.android.axion.widgets.quicklook.AxQuickLookReceiver"
            android:label="@string/setup_title"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_quicklook_widget" />
        </receiver>

        <receiver
            android:name="com.android.axion.widgets.cardlab.AxBatteryReceiver"
            android:label="@string/battery_widget"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_battery_widget" />
        </receiver>

        <receiver android:name=".cardlab.photo.AxPhotoReceiver"
            android:label="@string/label_photo"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_photo_widget" />
        </receiver>

        <activity
            android:name=".cardlab.photo.PhotoWidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".cardlab.tile.AxTileReceiver"
            android:label="@string/label_tile"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_tile_widget" />
        </receiver>

        <activity
            android:name=".cardlab.tile.TileConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.android.axion.widgets.cardlab.screentime.AxScreenTimeReceiver"
            android:label="@string/label_screentime"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_screentime_widget" />
        </receiver>

        <receiver
            android:name=".cardlab.media.AxMediaPlayerReceiver"
            android:label="@string/label_media_player"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.android.axion.widgets.ACTION_MEDIA_PLAY_PAUSE" />
                <action android:name="com.android.axion.widgets.ACTION_MEDIA_NEXT" />
                <action android:name="com.android.axion.widgets.ACTION_MEDIA_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_media_widget" />
        </receiver>

        <receiver
            android:name="com.android.axion.widgets.cardlab.AxYearProgressReceiver"
            android:label="@string/label_year_progress"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_year_widget" />
        </receiver>

        <!-- Digital Clock -->
        <receiver
            android:name=".cardlab.clock.AxDigitalClockReceiver"
            android:label="@string/label_digital_clock"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_digital_clock_widget" />
        </receiver>

        <!-- Analog Clock -->
        <receiver
            android:name=".cardlab.clock.AxAnalogClockReceiver"
            android:label="@string/label_analog_clock"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_analog_clock_widget" />
        </receiver>

        <!-- World Clock -->
        <receiver
            android:name=".cardlab.clock.AxWorldClockReceiver"
            android:label="@string/label_world_clock"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_world_clock_widget" />
        </receiver>

        <activity
            android:name=".cardlab.clock.WorldClockConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".cardlab.clock.DigitalClockConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Countdown -->
        <receiver
            android:name=".cardlab.countdown.AxCountdownReceiver"
            android:label="@string/label_countdown"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_countdown_widget" />
        </receiver>

        <activity
            android:name=".cardlab.countdown.CountdownConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Date -->
        <receiver
            android:name=".cardlab.date.AxDateReceiver"
            android:label="@string/label_date"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_date_widget" />
        </receiver>

        <!-- Pedometer -->
        <receiver
            android:name=".cardlab.pedometer.AxPedometerReceiver"
            android:label="@string/label_pedometer"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_pedometer_widget" />
        </receiver>

        <activity
            android:name=".cardlab.pedometer.PedometerConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Compass -->
        <receiver
            android:name=".cardlab.compass.AxCompassReceiver"
            android:label="@string/label_compass"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_compass_widget" />
        </receiver>

        <!-- Rock Paper Scissors -->
        <receiver
            android:name=".cardlab.fidget.AxRpsReceiver"
            android:label="@string/label_rps"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.android.axion.widgets.ACTION_RPS_PLAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_rps_widget" />
        </receiver>

        <!-- Bottle Spinner -->
        <receiver
            android:name=".cardlab.fidget.AxBottleSpinnerReceiver"
            android:label="@string/label_bottle_spinner"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.android.axion.widgets.ACTION_BOTTLE_SPIN" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ax_bottle_spinner_widget" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <receiver
            android:name=".quicklook.MessageProvider$RotateReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.android.axion.widgets.ACTION_ROTATE_MESSAGE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AxionReceiver"
            android:exported="true">
            <intent-filter android:priority="0">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.CONFIGURATION_CHANGED"/>
            </intent-filter>
        </receiver>

        <service
            android:name=".WidgetUpdateService"
            android:exported="false" />

    </application>

</manifest>
